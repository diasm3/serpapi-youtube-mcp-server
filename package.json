{
  "name": "youtube-data-mcp",
  "version": "2.0.0",
  "description": "MCP server for YouTube data extraction - transcripts, comments, and search",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "youtube-data-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "comments",
    "serpapi",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "youtube-caption-extractor": "^1.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
